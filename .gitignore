# Python
.venv/
__pycache__/
*.pyc

# OS
.DS_Store

# Claude Code local settings (personal permissions, not shared config)
.claude/settings.local.json

# Raw/archival EBL source data -- large binary sailing logs, not source code.
# Keep your own backup of these; only ebl_data/ + races.json define what the
# app actually knows about.
W2K_Dump/
ebl_data/
*.ebl

# Generated at runtime by build_race_db.py / render_*.py / the web app --
# reproducible from ebl_data/ + races.json, so there's no need to version them.
race_sessions.db
races/
index.html
course_data.json
polar_data.json
ebl_manifest.json
races.json

# Old exploratory artifacts from before the web app existed
*.n2k.csv
*x.n2kdecoded.csv
out_008.csv
config_008.json
course_visualization.html
polar_visualization.html
w2k_dump_summary.*

# Third-party reference PDFs (Actisense manuals) -- not ours to redistribute
Docs/
.env
